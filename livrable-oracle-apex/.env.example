# Copier ce fichier en ".env" et remplacer toutes les valeurs avant de lancer
# `docker compose up -d --build`. Ce fichier .env ne doit JAMAIS être versionné
# (voir .gitignore) ni transmis par un canal non sécurisé.

# --- Oracle Database / APEX / ORDS -----------------------------------------
# Règle Oracle : au moins 8 caractères, 1 majuscule, 1 minuscule, 1 chiffre
ORACLE_PWD=ChangezMoi1!
APEX_ADMIN_PWD=ChangezMoi2!
APEX_PUBLIC_USER_PWD=ChangezMoi3!

# --- Connexion SQL Server distant (pont REST) -------------------------------
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DB=
SQLSERVER_USER=
SQLSERVER_PWD=
